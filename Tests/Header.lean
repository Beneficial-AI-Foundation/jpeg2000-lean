/-- Hand-checked tiles with tile-part overrides: file, tile index, expected component lines
(`compStr`; empty to compare the POC only), and the POC entries that apply to the tile
(the main header's when the tile has none) as
`(RSpoc, CSpoc, LYEpoc, REpoc, CEpoc, Ppoc)`. Values decoded by hand from the tile-part
header bytes (see the module doc). -/
def tileChecks : List (String × Nat × List String × List (Nat × Nat × Nat × Nat × Nat × Nat)) :=
  let p03 := "0 2 6 6 0 1 [15/15 15/15] 0 2 [0/4 0/5 0/5 0/6] 7"
  [ ("conformance/p0_03.j2k", 0, [p03], [(0, 0, 8, 33, 255, 0)]),
    ("conformance/p0_15.j2k", 0, [p03], [(0, 0, 8, 33, 255, 0)]),
    ("conformance/p0_06.j2k", 0,
      ["0 7 6 6 0 0 [15/15 15/15 15/15 15/15 15/15 15/15 15/15] 2 3 [512/7 518/7 522/7 524/7 516/6 524/6 522/6 527/5 523/5 549/5 557/4 561/4 853/4 852/3 700/3 163/2 78/1 1508/2 1831/1] 9"], []),
    ("conformance/p0_07.j2k", 0, [], [(0, 0, 9, 3, 3, 0), (0, 0, 9, 8, 3, 0)]),
    ("conformance/p1_04.j2k", 1,
      ["0 4 6 6 0 0 [15/15 15/15 15/15 15/15] 2 2 [75/8 1093/10 1098/10 1115/10 1157/9 1134/9 1186/9 1217/8 1245/8 1248/8] 0"], []),
    ("nonregression/movie_00000.j2k", 0,
      List.replicate 3 "0 6 6 6 0 1 [15/15 15/15 15/15 15/15 15/15 15/15] 0 2 [0/8 0/9 0/9 0/10 0/9 0/9 0/10 0/9 0/9 0/10 0/9 0/9 0/10 0/9 0/9 0/10] 0", []),
    ("nonregression/Bretagne2.j2k", 24,
      List.replicate 3 "1 6 5 5 0 1 [4/4 5/5 6/6 7/7 7/7 7/7] 0 2 [0/8 0/9 0/9 0/10 0/9 0/9 0/10 0/9 0/9 0/10 0/9 0/9 0/10 0/9 0/9 0/10] 0", []) ]

/-- Files expected to fail in `TilePart.parseTileParts` until it adopts OpenJPEG's `TNsot`
correction (these encoders write `TNsot` one too small; `opj_j2k_read_sot`'s
`m_nb_tile_parts_correction`). Reported as XFAIL, not counted; a parse that succeeds is
compared normally. -/
def xfailTNsot : List String :=
  ["nonregression/issue208.jp2", "nonregression/issue559-eci-090-CIELab.jp2"]

/-- Corpus root. -/
def corpusDir : System.FilePath := "corpus/files/openjpeg-data/input"

/-- Tiles whose coding differs from the defaults (from the checks of `tileChecks`). -/
def overridden (file : String) : List Nat :=
  if file == "conformance/p1_04.j2k" then (List.range 63).map (· + 1)
  else (tileChecks.filter (·.1 == file)).map (·.2.1)

/-- Parses every corpus file and compares with `table` and `tileChecks`. -/
def corpus : IO Nat := do
  let mut f := 0
  let mut checked := 0
  for row in table do
    let p := corpusDir / row.file
    if !(← p.pathExists) then continue
    checked := checked + 1
    let data ← IO.FS.readBinFile p
    match parse Limits.default data with
    | .error e =>
      if xfailTNsot.contains row.file then
        IO.println s!"  header: XFAIL {row.file}: {e}"
        -- The main-header merge alone must still match `opj_dump`.
        let main := do
          let c ← Box.parseFile Limits.default data
          let r ← rangeReader data { offset := c.codestream.start, length := c.codestream.len }
          let (mh, _) ← parseMainHeader Limits.default r
          return (← mainCoding mh)
        match main with
        | .error e => f := f + (← expect s!"{row.file}: main header: {e}" false)
        | .ok d =>
          let got := rle (d.comps.toList.map compStr)
          f := f + (← expect s!"{row.file}: main-header components {got} ≠ {row.comps}"
            (got == row.comps))
      else f := f + (← expect s!"{row.file}: {e}" false)
    | .ok h =>
      f := f + (← expect s!"{row.file}: tile line {tileStr h} ≠ {row.tile}" (tileStr h == row.tile))
      let got := rle (h.defaults.comps.toList.map compStr)
      f := f + (← expect s!"{row.file}: default tile components {got} ≠ {row.comps}"
        (got == row.comps))
      f := f + (← expect s!"{row.file}: container" (h.container.isSome == row.file.endsWith ".jp2"))
      -- Tiles without overrides share the defaults; others are checked by hand.
      let ov := overridden row.file
      for t in h.tiles do
        if ov.contains t.index then continue
        f := f + (← expect s!"{row.file}: tile {t.index} = defaults" (t.coding == h.defaults))
      for (file, ti, compsExp, pocExp) in tileChecks do
        if file != row.file then continue
        match h.tiles.find? (·.index == ti) with
        | none => f := f + (← expect s!"{file}: tile {ti} missing" false)
        | some t =>
          let comps := t.coding.comps.toList.map compStr
          if !compsExp.isEmpty then
            f := f + (← expect s!"{file}: tile {ti} components {comps}"
              (compsExp.length ≤ comps.length && comps.take compsExp.length == compsExp))
          let poc := t.coding.poc.toList.map fun e => (e.resStart.toNat, e.compStart.toNat,
            e.layerEnd.toNat, e.resEnd.toNat, e.compEndRaw.toNat, e.order.toUInt8.toNat)
          f := f + (← expect s!"{file}: tile {ti} POC {poc}" (poc == pocExp))
  if checked == 0 then IO.println "  header: corpus absent, skipped"
  else if checked < table.length then
    IO.println s!"  header: {checked}/{table.length} corpus files present"
  return f

/-- Runs the suite; returns the number of failures. -/
def run : IO Nat := do
  return (← precedence) + (← validation) + (← corpus)

end JPEG2000.Tests.Header
