import JPEG2000.Header

/-!
# Unit and corpus tests: merged codestream header (task 1.5)

Plan.md §3 rule 3, §4 S2/S3, §8; T.800 A.6 (COD/COC/QCD/QCC/RGN/POC precedence), B.3–B.6
(tile and tile-component geometry, code-block and precinct counts), E.1 (derived step
sizes), G.2 (MCT).

* Hand-built streams: every precedence rule (main COC vs tile COD, main QCC vs tile QCD, tile
  COC/QCC, tile RGN vs main RGN, tile POC replacing main POC across tile-parts), tile and
  tile-component rectangles, effective code-block sizes, and each validation error (MCT,
  POC, step-size counts, duplicate per-component segments, every `Limits` check).
* Corpus: every file of `corpus/files/openjpeg-data/input/conformance` (23 T.803 streams,
  `file1..9.jp2`, `zoo1.jp2`) and every benchmark file of `nonregression` must `parse` under
  `Limits.default`; the merged main-header parameters (`Header.defaults`, OpenJPEG's
  "default tile") of every file are compared with `opj_dump -i` (OpenJPEG 2.5.3, table
  generated by a script from its output: tile grid, `Scod`, progression, layers, MCT, and
  per component `Scoc` bit 0, resolutions, code-block exponents and style, transform,
  precinct sizes, quantisation style, guard bits, step sizes, ROI shift). `opj_dump` does
  not print per-tile parameters, so the tiles with tile-part overrides (found by scanning:
  p0_03/p0_15 tile 0 RGN, p0_06 tile 0 RGN, p0_07 tile 0 POC in two tile-parts, p1_04
  tiles 1–63 QCD, movie_00000 / Bretagne2 tile COC+QCC) are checked against values decoded
  by hand (an independent Python walker of the tile-part headers) and every other tile is
  checked to equal the defaults. Skipped when the corpus is absent.
-/

namespace JPEG2000.Tests.Header

open JPEG2000 JPEG2000.Bytes JPEG2000.Marker JPEG2000.TilePart JPEG2000.Header

/-- Runs one named check, printing a line on failure; returns 1 on failure. -/
def expect (name : String) (ok : Bool) : IO Nat := do
  if ok then return 0
  IO.eprintln s!"  FAIL header: {name}"
  return 1

/-- The outcome class of a parse. -/
def kind {α : Type} : Except Error α → String
  | .ok _ => "ok"
  | .error (.truncated ..) => "truncated"
  | .error (.malformed ..) => "malformed"
  | .error (.unsupported ..) => "unsupported"
  | .error (.limitExceeded _ k _ _) => s!"limit {k}"

/-- Checks the outcome class of a parse. -/
def expectKind {α : Type} (name : String) (k : String) (x : Except Error α) : IO Nat := do
  let msg := match x with | .error e => s!" ({e})" | .ok _ => ""
  expect s!"{name}: expected {k}, got {kind x}{msg}" (kind x == k)

/-- The value of an `Except`, if any. -/
def ok? {ε α : Type} : Except ε α → Option α
  | .ok a => some a
  | .error _ => none

/-! ## Rendering (the fields and format of `opj_dump`'s "default tile") -/

/-- Space-separated rendering of a list. -/
def joinSp (xs : List String) : String := " ".intercalate xs

/-- One component as `opj_dump` prints it: `csty numres cblkw cblkh cblksty qmfbid
[PPx/PPy …] qntsty numgbits [m/e …] roishift` (derived quantisation: only the base step,
as `opj_dump`). -/
def compStr (p : CompParams) : String :=
  let prec := joinSp (p.precincts.toList.map fun q => s!"{q.ppx}/{q.ppy}")
  let steps := if p.quantStyle = 1 then p.steps.toList.take 1 else p.steps.toList
  let st := joinSp (steps.map fun s => s!"{s.mantissa}/{s.exponent}")
  let t := match p.transform with | .reversible53 => 1 | .irreversible97 => 0
  s!"{if p.precinctsDefined then 1 else 0} {p.levels + 1} {p.cbWidthExp} {p.cbHeightExp} " ++
    s!"{p.cbStyle} {t} [{prec}] {p.quantStyle} {p.guardBits} [{st}] {p.roiShift}"

/-- Run-length encoding of a list. -/
def rle (xs : List String) : List (Nat × String) :=
  xs.foldr (fun x acc => match acc with
    | (n, y) :: rest => if x == y then (n + 1, y) :: rest else (1, x) :: acc
    | [] => [(1, x)]) []

/-- The tile-level line: `tw th Scod prg numlayers mct`. -/
def tileStr (h : Header) : String :=
  s!"{h.numTilesX} {h.numTilesY} {h.main.cod.scod} {h.defaults.progression.toUInt8} " ++
    s!"{h.defaults.layers} {if h.defaults.mct then 1 else 0}"

/-! ## Hand-built streams -/

/-- Big-endian 16-bit bytes. -/
def be16 (v : Nat) : List UInt8 := [(v / 256 % 256).toUInt8, (v % 256).toUInt8]

/-- Big-endian 32-bit bytes. -/
def be32 (v : Nat) : List UInt8 := be16 (v / 65536 % 65536) ++ be16 (v % 65536)

/-- A marker segment: marker, `Lxxx`, body. -/
def seg (m : Nat) (body : List UInt8) : List UInt8 := be16 m ++ be16 (body.length + 2) ++ body

/-- A SIZ body: grid `x`×`y` with offsets `xo, yo`, tiles `xt`×`yt` at `xto, yto`, and
components `(Ssiz, XRsiz, YRsiz)`. -/
def sizBody (x y xo yo xt yt xto yto : Nat) (comps : List (UInt8 × UInt8 × UInt8)) :
    List UInt8 :=
  be16 0 ++ be32 x ++ be32 y ++ be32 xo ++ be32 yo ++ be32 xt ++ be32 yt ++ be32 xto ++
    be32 yto ++ be16 comps.length ++ comps.flatMap fun (s, a, b) => [s, a, b]

/-- A COD body: `Scod`, progression, layers, MCT, then `SPcod` (levels, xcb, ycb, style,
transform, precinct bytes). -/
def cod (scod prg layers mct levels xcb ycb : Nat) (tr : Nat := 1) (prec : List UInt8 := []) :
    List UInt8 :=
  [scod.toUInt8, prg.toUInt8] ++ be16 layers ++
    [mct.toUInt8, levels.toUInt8, xcb.toUInt8, ycb.toUInt8, 0, tr.toUInt8] ++ prec

/-- A COC body (Csiz < 257): component, `Scoc`, `SPcoc`. -/
def coc (c levels xcb ycb : Nat) (tr : Nat := 1) (prec : List UInt8 := []) : List UInt8 :=
  [c.toUInt8, if prec.isEmpty then 0 else 1, levels.toUInt8, xcb.toUInt8, ycb.toUInt8, 0,
   tr.toUInt8] ++ prec

/-- A "no quantisation" QCD body: guard bits 2, the given exponents. -/
def qcdNone (es : List Nat) : List UInt8 := [0x40] ++ es.map fun e => (e * 8).toUInt8

/-- An expounded QCD body: guard bits 1, step sizes `(exponent, mantissa)`. -/
def qcdExp (ss : List (Nat × Nat)) : List UInt8 :=
  [0x22] ++ ss.flatMap fun (e, m) => be16 (e * 2048 + m)

/-- A derived QCD body: guard bits 1, base `(exponent, mantissa)`. -/
def qcdDer (e m : Nat) : List UInt8 := [0x21] ++ be16 (e * 2048 + m)

/-- A POC entry (Csiz < 257). -/
def pocE (rs cs ly re ce p : Nat) : List UInt8 :=
  [rs.toUInt8, cs.toUInt8] ++ be16 ly ++ [re.toUInt8, ce.toUInt8, p.toUInt8]

/-- A tile-part: SOT (`Psot` computed), header segments, SOD, two data bytes. -/
def tp (isot tpsot tnsot : Nat) (segs : List UInt8) : List UInt8 :=
  let data : List UInt8 := [0, 0]
  be16 0xFF90 ++ be16 10 ++ be16 isot ++ be32 (12 + segs.length + 2 + data.length) ++
    [tpsot.toUInt8, tnsot.toUInt8] ++ segs ++ be16 0xFF93 ++ data

/-- A codestream: SOC, SIZ, main segments, tile-parts, EOC. -/
def stream (siz main parts : List UInt8) : ByteArray :=
  (be16 0xFF4F ++ seg 0xFF51 siz ++ main ++ parts ++ be16 0xFFD9).toByteArray

/-- Three 8-bit components, no sub-sampling. -/
def comps3 : List (UInt8 × UInt8 × UInt8) := [(7, 1, 1), (7, 1, 1), (7, 1, 1)]

/-- The 64×64 image in four 32×32 tiles with three components. -/
def siz4 : List UInt8 := sizBody 64 64 0 0 32 32 0 0 comps3

/-- Main header of the precedence stream: COD (2 levels, 2⁴ blocks), QCD (7 bands),
COC comp 1 (1 level), QCC comp 1 (4 expounded steps), RGN comp 2 (shift 5), POC (one
entry). -/
def mainP : List UInt8 :=
  seg 0xFF52 (cod 0 0 3 0 2 2 2) ++ seg 0xFF5C (qcdNone [8, 9, 9, 10, 9, 9, 10]) ++
    seg 0xFF53 (coc 1 1 3 3) ++ seg 0xFF5D ([1] ++ qcdExp [(9, 1), (9, 2), (9, 3), (8, 4)]) ++
    seg 0xFF5E [2, 0, 5] ++ seg 0xFF5F (pocE 0 0 1 3 3 1)

/-- Tile-parts of the precedence stream. Tile 0: COD (3 levels), QCD (10 bands), COC comp 2
(0 levels), QCC comp 2 (1 band), RGN comp 0 (shift 4). Tile 1: nothing. Tile 2: QCD only
(7 bands). Tile 3: two tile-parts, POC (two entries) in the second. -/
def partsP : List UInt8 :=
  tp 0 0 1 (seg 0xFF5E [0, 0, 4] ++ seg 0xFF5D ([2] ++ qcdNone [7]) ++ seg 0xFF53 (coc 2 0 2 2) ++
    seg 0xFF52 (cod 6 2 5 0 3 2 2) ++ seg 0xFF5C (qcdNone (List.replicate 10 11))) ++
  tp 1 0 1 [] ++
  tp 2 0 1 (seg 0xFF5C (qcdNone [12, 12, 12, 12, 12, 12, 12])) ++
  tp 3 0 2 [] ++
  tp 3 1 2 (seg 0xFF5F (pocE 0 0 1 2 3 2 ++ pocE 1 0 1 3 3 3))

/-- Summary of a tile-component: levels, steps (exponents), ROI shift. -/
def compSum (p : CompParams) : Nat × List Nat × Nat :=
  (p.levels, p.steps.toList.map (·.exponent.toNat), p.roiShift)

/-- Summary of a tile's coding: per-component summaries. -/
def codingSum (c : Coding) : List (Nat × List Nat × Nat) := c.comps.toList.map compSum

/-- Parses a codestream with the default limits. -/
def pc (b : ByteArray) : Except Error Header := parseCodestream Limits.default b

/-- Precedence, geometry and coding tests on hand-built streams. -/
def precedence : IO Nat := do
  let mut f := 0
  match pc (stream siz4 mainP partsP) with
  | .error e => f := f + (← expect s!"precedence stream parses: {e}" false)
  | .ok h =>
    let d := codingSum h.defaults
    f := f + (← expect "defaults: main COD, main COC comp 1, main QCC comp 1, main RGN comp 2"
      (d == [(2, [8, 9, 9, 10, 9, 9, 10], 0), (1, [9, 9, 9, 8], 0), (2, [8, 9, 9, 10, 9, 9, 10], 5)]))
    f := f + (← expect "defaults: SGcod" (h.defaults.progression == .lrcp &&
      h.defaults.layers == 3 && !h.defaults.mct && !h.defaults.sop && h.defaults.poc.size == 1))
    f := f + (← expect "four tiles present, indices" (h.tiles.toList.map (·.index) == [0, 1, 2, 3]))
    let t := fun i => (h.tiles[i]?.map (·.coding)).getD default
    f := f + (← expect "tile 0: tile COD > main COC (comp 1), tile QCD > main QCC, tile COC/QCC (comp 2), tile RGN comp 0, main RGN comp 2"
      (codingSum (t 0) == [(3, List.replicate 10 11, 4), (3, List.replicate 10 11, 0), (0, [7], 5)]))
    f := f + (← expect "tile 0: SGcod from tile COD"
      ((t 0).progression == .rpcl && (t 0).layers == 5 && (t 0).sop && (t 0).eph &&
       (t 0).poc.size == 1))
    f := f + (← expect "tile 1: defaults" (t 1 == h.defaults))
    f := f + (← expect "tile 2: tile QCD > main QCC (comp 1 keeps main COC levels)"
      (codingSum (t 2) == [(2, List.replicate 7 12, 0), (1, List.replicate 4 12, 0),
        (2, List.replicate 7 12, 5)]))
    f := f + (← expect "tile 3: tile POC (second tile-part) replaces main POC"
      ((t 3).poc.toList.map (fun e => (e.resStart.toNat, e.resEnd.toNat, e.order.toUInt8))
        == [(0, 2, 2), (1, 3, 3)] && codingSum (t 3) == d))
    f := f + (← expect "tile rectangles (B.3)" (h.tiles.toList.map (fun tp =>
      (tp.rect.x0, tp.rect.y0, tp.rect.x1, tp.rect.y1)) ==
        [(0, 0, 32, 32), (32, 0, 64, 32), (0, 32, 32, 64), (32, 32, 64, 64)]))
    f := f + (← expect "numTiles" (h.numTilesX == 2 && h.numTilesY == 2 && h.container.isNone))
  -- Geometry with offsets and sub-sampling.
  let sizO := sizBody 100 50 7 3 40 20 5 2 [(7, 1, 1), (7, 2, 3)]
  match pc (stream sizO (seg 0xFF52 (cod 0 0 1 0 2 4 4) ++ seg 0xFF5C (qcdNone (List.replicate 7 8)))
      (tp 0 0 1 [] ++ tp 7 0 1 [])) with
  | .error e => f := f + (← expect s!"offset stream parses: {e}" false)
  | .ok h =>
    f := f + (← expect "offset grid: 3×3 tiles" (h.numTilesX == 3 && h.numTilesY == 3))
    f := f + (← expect "tile 0 / tile 7 rectangles and tile-component rectangles (B-12)"
      (h.tiles.toList.map (fun tp => ((tp.rect.x0, tp.rect.y0, tp.rect.x1, tp.rect.y1),
        tp.compRects.toList.map fun r => (r.x0, r.y0, r.x1, r.y1))) ==
        [((7, 3, 45, 22), [(7, 3, 45, 22), (4, 1, 23, 8)]),
         ((45, 42, 85, 50), [(45, 42, 85, 50), (23, 14, 43, 17)])]))
  -- Effective code-block size (B.6).
  let p : CompParams :=
    { levels := 2, cbWidthExp := 6, cbHeightExp := 6, cbStyle := 0,
      transform := .reversible53, precinctsDefined := true,
      precincts := #[⟨4, 5⟩, ⟨5, 8⟩, ⟨8, 8⟩], quantStyle := 0, guardBits := 2,
      steps := #[], roiShift := 0 }
  f := f + (← expect "effective code-block exponents (B.6)"
    ([0, 1, 2].map (fun r => (p.effCbWidthExp r, p.effCbHeightExp r)) ==
      [(4, 5), (4, 6), (6, 6)]))
  -- 64×64: r0 LL 16×16 in 2^4×2^5 blocks (1); r1 three 16×16 bands in 2^4×2^6 (3);
  -- r2 three 32×32 bands (3); one precinct per resolution. 128×64 doubles r0/r1 widths:
  -- r0 32×16 → 2 blocks, r1 bands 32×16 → 2 each, r2 bands 64×32 → 1 each; precincts
  -- r0 2 (32 wide in 2^4), r1 2 (64 wide in 2^5), r2 1.
  f := f + (← expect "code-blocks and precincts of 64×64 and 128×64 tile-components"
    (tileCompCounts ⟨0, 0, 64, 64⟩ p == (7, 3) && tileCompCounts ⟨0, 0, 128, 64⟩ p == (11, 5)))
  -- Derived quantisation expands by E-5.
  match pc (stream (sizBody 16 16 0 0 16 16 0 0 [(7, 1, 1)])
      (seg 0xFF52 (cod 0 0 1 0 3 2 2) ++ seg 0xFF5C (qcdDer 10 77)) (tp 0 0 1 [])) with
  | .error e => f := f + (← expect s!"derived stream parses: {e}" false)
  | .ok h =>
    f := f + (← expect "derived step sizes (E-5)" ((h.defaults.comps[0]?.map fun c =>
      (c.quantStyle, c.guardBits, c.steps.toList.map fun s => (s.exponent.toNat, s.mantissa.toNat)))
      == some (1, 1, [(10, 77), (10, 77), (10, 77), (10, 77), (9, 77), (9, 77), (9, 77),
        (8, 77), (8, 77), (8, 77)])))
  return f

/-- Validation errors and limits. -/
def validation : IO Nat := do
  let mut f := 0
  let q7 := seg 0xFF5C (qcdNone (List.replicate 7 8))
  let one := tp 0 0 1 []
  let s1 := sizBody 64 64 0 0 64 64 0 0 [(7, 1, 1)]
  let s3 := sizBody 64 64 0 0 64 64 0 0 comps3
  let codA := seg 0xFF52 (cod 0 0 1 0 2 2 2)
  f := f + (← expectKind "baseline" "ok" (pc (stream s3 (codA ++ q7) one)))
  f := f + (← expectKind "MCT with Csiz 1 (lenient, as OpenJPEG)" "ok"
    (pc (stream s1 (seg 0xFF52 (cod 0 0 1 1 2 2 2) ++ q7) one)))
  f := f + (← expectKind "MCT with sub-sampled component 1" "malformed"
    (pc (stream (sizBody 64 64 0 0 64 64 0 0 [(7, 1, 1), (7, 2, 1), (7, 1, 1)])
      (seg 0xFF52 (cod 0 0 1 1 2 2 2) ++ q7) one)))
  f := f + (← expectKind "MCT with differing transforms (COC comp 2: 9/7)" "malformed"
    (pc (stream s3 (seg 0xFF52 (cod 0 0 1 1 2 2 2) ++ q7 ++ seg 0xFF53 (coc 2 2 2 2 0)) one)))
  f := f + (← expectKind "MCT switched on by a tile COD with sub-sampling" "malformed"
    (pc (stream (sizBody 64 64 0 0 64 64 0 0 [(7, 1, 1), (7, 1, 2), (7, 1, 1)]) (codA ++ q7)
      (tp 0 0 1 (seg 0xFF52 (cod 0 0 1 1 2 2 2))))))
  f := f + (← expectKind "POC CSpoc ≥ Csiz (CEpoc 0 = 256)" "malformed"
    (pc (stream s3 (codA ++ q7 ++ seg 0xFF5F (pocE 0 3 1 3 0 0)) one)))
  f := f + (← expectKind "tile POC CSpoc ≥ Csiz" "malformed"
    (pc (stream s3 (codA ++ q7) (tp 0 0 1 (seg 0xFF5F (pocE 0 4 1 3 0 0))))))
  f := f + (← expectKind "POC CEpoc > Csiz (lenient)" "ok"
    (pc (stream s3 (codA ++ q7 ++ seg 0xFF5F (pocE 0 1 1 3 9 0)) one)))
  f := f + (← expectKind "QCD none, 6 exponents for 7 bands" "malformed"
    (pc (stream s3 (codA ++ seg 0xFF5C (qcdNone (List.replicate 6 8))) one)))
  f := f + (← expectKind "QCD expounded, 4 steps for 7 bands" "malformed"
    (pc (stream s3 (codA ++ seg 0xFF5C (qcdExp [(8, 0), (8, 0), (8, 0), (8, 0)])) one)))
  f := f + (← expectKind "QCD none, 10 exponents for 7 bands (extra ignored)" "ok"
    (pc (stream s3 (codA ++ seg 0xFF5C (qcdNone (List.replicate 10 8))) one)))
  f := f + (← expectKind "main QCD too short for a tile COD's levels" "malformed"
    (pc (stream s3 (codA ++ q7) (tp 0 0 1 (seg 0xFF52 (cod 0 0 1 0 3 2 2))))))
  f := f + (← expectKind "derived εo = NL − 2" "malformed"
    (pc (stream s1 (seg 0xFF52 (cod 0 0 1 0 5 2 2) ++ seg 0xFF5C (qcdDer 3 0)) one)))
  f := f + (← expectKind "derived εo = NL − 1" "ok"
    (pc (stream s1 (seg 0xFF52 (cod 0 0 1 0 5 2 2) ++ seg 0xFF5C (qcdDer 4 0)) one)))
  f := f + (← expectKind "second main COC for a component" "malformed"
    (pc (stream s3 (codA ++ q7 ++ seg 0xFF53 (coc 1 1 2 2) ++ seg 0xFF53 (coc 1 2 2 2)) one)))
  f := f + (← expectKind "second tile QCC for a component" "malformed"
    (pc (stream s3 (codA ++ q7) (tp 0 0 1 (seg 0xFF5D ([1] ++ qcdNone (List.replicate 7 8)) ++
      seg 0xFF5D ([1] ++ qcdNone (List.replicate 7 8)))))))
  f := f + (← expectKind "second main RGN for a component" "malformed"
    (pc (stream s3 (codA ++ q7 ++ seg 0xFF5E [0, 0, 1] ++ seg 0xFF5E [0, 0, 2]) one)))
  -- Limits (each checked from the geometry, before allocation).
  let D := Limits.default
  let big := sizBody 200000 10 0 0 200000 10 0 0 [(7, 1, 1)]
  f := f + (← expectKind "image side > 2^17" "limit imageSide"
    (pc (stream big (codA ++ q7) one)))
  let sq := sizBody 20000 20000 0 0 20000 20000 0 0 [(7, 1, 1)]
  f := f + (← expectKind "image area > 2^28" "limit imageArea" (pc (stream sq (codA ++ q7) one)))
  let manyTiles := sizBody 64 64 0 0 1 1 0 0 [(7, 1, 1)]
  f := f + (← expectKind "4096 tiles > strict 256" "limit tiles"
    (parseCodestream Limits.strict (stream manyTiles (codA ++ q7) one)))
  f := f + (← expectKind "tile-components > maxCodeBlocks" "limit codeBlocks"
    (parseCodestream { D with maxCodeBlocks := 4095 } (stream manyTiles (codA ++ q7) one)))
  f := f + (← expectKind "work samples" "limit workSamples"
    (parseCodestream { D with maxWorkSamples := 3 * 4096 - 1 } (stream s3 (codA ++ q7) one)))
  f := f + (← expectKind "decoded bytes (16-bit samples count 2)" "limit decodedBytes"
    (parseCodestream { D with maxDecodedBytes := 2 * 4096 - 1 }
      (stream (sizBody 64 64 0 0 64 64 0 0 [(15, 1, 1)]) (codA ++ q7) one)))
  -- 64×64, 2 levels, 2^4 blocks: r0 16×16 → 4·4 = 16 blocks... counted exactly
  let cbCount := (tileCompCounts ⟨0, 0, 64, 64⟩ ((ok? (pc (stream s1 (codA ++ q7) one))).bind
    (·.defaults.comps[0]?) |>.getD default)).1
  f := f + (← expect s!"code-block count of 64×64, 2 levels, 16×16 blocks = 16 (got {cbCount})"
    (cbCount == 16))
  f := f + (← expectKind "code-blocks over the limit" "limit codeBlocks"
    (parseCodestream { D with maxCodeBlocks := 15 } (stream s1 (codA ++ q7) one)))
  f := f + (← expectKind "code-blocks at the limit" "ok"
    (parseCodestream { D with maxCodeBlocks := 16 } (stream s1 (codA ++ q7) one)))
  f := f + (← expectKind "precincts over the limit (3 resolutions, 1 precinct each)" "limit precincts"
    (parseCodestream { D with maxPrecincts := 2 } (stream s1 (codA ++ q7) one)))
  f := f + (← expectKind "packets over the limit (3 layers × 3 precincts)" "limit packets"
    (parseCodestream { D with maxPackets := 8 }
      (stream s1 (seg 0xFF52 (cod 0 0 3 0 2 2 2) ++ q7) one)))
  f := f + (← expectKind "absent tiles count too (4 tiles, 1 present)" "limit codeBlocks"
    (parseCodestream { D with maxCodeBlocks := 4 * 16 - 1 }
      (stream (sizBody 128 128 0 0 64 64 0 0 [(7, 1, 1)]) (codA ++ q7) one)))
  f := f + (← expectKind "input bytes" "limit inputBytes"
    (parseCodestream { D with maxInputBytes := 10 } (stream s1 (codA ++ q7) one)))
  return f

/-! ## Corpus -/

/-- One file's expected "default tile" from `opj_dump -i`: `tw th Scod prg layers mct` and the
run-length encoded component lines (format of `compStr`). -/
structure Row where
  /-- Path under `corpus/files/openjpeg-data/input`. -/
  file : String
  /-- The tile-level line. -/
  tile : String
  /-- Run-length encoded component lines. -/
  comps : List (Nat × String)

def table : List Row := [
  { file := "conformance/file1.jp2", tile := "1 1 0 0 1 1",
    comps := [(3, "0 6 6 6 0 1 [15/15 15/15 15/15 15/15 15/15 15/15] 0 1 [0/10 0/11 0/11 0/12 0/11 0/11 0/12 0/11 0/11 0/12 0/11 0/11 0/12 0/11 0/11 0/12] 0")] },
  { file := "conformance/file2.jp2", tile := "1 1 0 0 1 0",
    comps := [(3, "0 6 6 6 0 1 [15/15 15/15 15/15 15/15 15/15 15/15] 0 1 [0/10 0/11 0/11 0/12 0/11 0/11 0/12 0/11 0/11 0/12 0/11 0/11 0/12 0/11 0/11 0/12] 0")] },
  { file := "conformance/file3.jp2", tile := "1 1 0 0 1 0",
    comps := [(3, "0 6 6 6 0 1 [15/15 15/15 15/15 15/15 15/15 15/15] 0 1 [0/10 0/11 0/11 0/12 0/11 0/11 0/12 0/11 0/11 0/12 0/11 0/11 0/12 0/11 0/11 0/12] 0")] },
