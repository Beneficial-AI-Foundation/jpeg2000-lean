import JPEG2000.TilePart

/-!
# Unit and corpus tests: tile-parts and pointer segments (task 1.4)

Plan.md §4 S2/S3, §8; T.800 A.4 (SOT/SOD/EOC), A.7 (TLM/PLT/PPM/PPT). Hand-built
codestreams (single tile-part, tiles out of order, interleaved tile-parts, `Psot = 0`,
`TNsot` mismatch, the one-too-small `TNsot` correction (task 1.9), `Isot` out of range,
duplicate/out-of-order `TPsot`, truncation, PPT, PLT with multi-byte lengths, TLM, PPM spanning segments, limits) and the 23 T.803 streams.

`opj_dump -i` (OpenJPEG 2.5.3) prints only the main-header codestream index, not tile-part
positions (its tile index is filled only when tiles are decoded), so the corpus table was
generated by an independent throwaway Python walker over the files (SOT/Psot chain, segment
lengths, PLT varints, TLM entry counts, PPM `Nppm` chunks), with the main-header end taken
from `opj_dump -i`. The corpus part is skipped when the files are absent.
-/

namespace JPEG2000.Tests.TilePart

open JPEG2000 JPEG2000.Bytes JPEG2000.Marker JPEG2000.TilePart

/-- Runs one named check, printing a line on failure; returns 1 on failure, 0 on success. -/
def expect (name : String) (ok : Bool) : IO Nat := do
  if ok then return 0
  IO.eprintln s!"  FAIL tilepart: {name}"
  return 1

/-- The outcome class of a parse: `ok`, `truncated`, `malformed`, `unsupported`, `limit`. -/
def kind {α : Type} : Except Error α → String
  | .ok _ => "ok"
  | .error (.truncated ..) => "truncated"
  | .error (.malformed ..) => "malformed"
  | .error (.unsupported ..) => "unsupported"
  | .error (.limitExceeded ..) => "limit"

/-- Checks the outcome class of a parse, printing the error on mismatch. -/
def expectKind {α : Type} (name : String) (k : String) (x : Except Error α) : IO Nat := do
  let got := kind x
  let msg := match x with | .error e => s!" ({e})" | .ok _ => ""
  expect s!"{name}: expected {k}, got {got}{msg}" (got == k)

/-- A reader over a list of bytes. -/
def rd (bs : List UInt8) : Reader := Reader.ofByteArray bs.toByteArray

/-- Big-endian 16-bit bytes. -/
def be16 (v : Nat) : List UInt8 := [(v / 256 % 256).toUInt8, (v % 256).toUInt8]

/-- Big-endian 32-bit bytes. -/
def be32 (v : Nat) : List UInt8 := be16 (v / 65536 % 65536) ++ be16 (v % 65536)

/-- A marker segment: marker, `Lxxx` = body length + 2, body. -/
def seg (m : Nat) (body : List UInt8) : List UInt8 := be16 m ++ be16 (body.length + 2) ++ body

/-- A SIZ body: `w`×`h` image at the origin, `tw`×`th` tiles, one 8-bit component. -/
def sizBody (w h tw th : Nat) : List UInt8 :=
  be16 0 ++ be32 w ++ be32 h ++ be32 0 ++ be32 0 ++ be32 tw ++ be32 th ++ be32 0 ++ be32 0 ++
    be16 1 ++ [7, 1, 1]

/-- A valid COD body (LRCP, 1 layer, 2 levels, 64×64, 5/3). -/
def codBody : List UInt8 := [0, 0] ++ be16 1 ++ [0, 2, 4, 4, 0, 1]

/-- A valid QCD body (no quantisation, 7 bands). -/
def qcdBody : List UInt8 := [0x40] ++ List.replicate 7 (0x40 : UInt8)

/-- A main header (SOC, SIZ, COD, QCD, extra segments) for a 64×32 image in `tw`×`th`
tiles. -/
def mainHdr (tw th : Nat) (extra : List UInt8 := []) : List UInt8 :=
  be16 0xFF4F ++ seg 0xFF51 (sizBody 64 32 tw th) ++ seg 0xFF52 codBody ++
    seg 0xFF5C qcdBody ++ extra

/-- A tile-part: SOT (with `Psot` computed, or 0), header segments, SOD, data. -/
def tp (isot tpsot tnsot : Nat) (segs data : List UInt8) (psot0 : Bool := false) :
    List UInt8 :=
  let psot := if psot0 then 0 else 12 + segs.length + 2 + data.length
  be16 0xFF90 ++ be16 10 ++ be16 isot ++ be32 psot ++ [tpsot.toUInt8, tnsot.toUInt8] ++ segs ++
    be16 0xFF93 ++ data

/-- `EOC`. -/
def eoc : List UInt8 := be16 0xFFD9

/-- Parses main header and tile-parts with the given limits. -/
def parseWith (L : Limits) (bs : List UInt8) : Except Error (Array Tile) := do
  let (mh, r) ← parseMainHeader L (rd bs)
  parseTileParts L mh r

/-- Parses with the default limits. -/
def parse (bs : List UInt8) : Except Error (Array Tile) := parseWith Limits.default bs

/-- The value of an `Except`, if any. -/
def ok? {ε α : Type} : Except ε α → Option α
  | .ok a => some a
  | .error _ => none

/-- Summary of tiles: (index, number of parts, `(TPsot, data offset, data length)` list). -/
def summary (ts : Array Tile) : List (Nat × List (Nat × Nat × Nat)) :=
  ts.toList.map fun t =>
    (t.index, t.parts.toList.map fun p => (p.sot.tpsot.toNat, p.data.offset, p.data.length))

/-! ## Hand-built streams -/

/-- Tile-part structure tests. -/
def structureTests : IO Nat := do
  let mut f := 0
  -- single tile, single tile-part
  let h1 := mainHdr 64 32
  let s1 := h1 ++ tp 0 0 1 [] [1, 2, 3] ++ eoc
  let d0 := h1.length + 14
  f := f + (← expect "single tile-part"
    ((ok? (parse s1)).map summary == some [(0, [(0, d0, 3)])]))
  -- 2×2 tiles (32×16), tiles out of order, tile 0 in two interleaved parts
  let h4 := mainHdr 32 16
  let a := tp 1 0 1 [] [9]
  let b := tp 0 0 0 [] [7, 7]
  let c := tp 0 1 2 [] []
  let s2 := h4 ++ a ++ b ++ c ++ eoc
  let o := h4.length
  f := f + (← expect "two tiles out of order"
    ((ok? (parse s2)).map summary ==
      some [(0, [(0, o + a.length + 14, 2), (1, o + a.length + b.length + 14, 0)]),
            (1, [(0, o + 14, 1)])]))
  f := f + (← expect "TNsot recorded"
    ((ok? (parse s2)).map (fun ts => ts.toList.map (·.tnsot)) == some [2, 1]))
  -- Psot = 0 on the last tile-part: data runs up to EOC
  let s3 := h4 ++ a ++ tp 2 0 1 [] [5, 6, 7, 8] (psot0 := true) ++ eoc
  f := f + (← expect "Psot = 0 last"
    ((ok? (parse s3)).map summary ==
      some [(1, [(0, o + 14, 1)]), (2, [(0, o + a.length + 14, 4)])]))
  f := f + (← expectKind "Psot = 0 without EOC" "truncated"
    (parse (h4 ++ tp 2 0 1 [] [5, 6] (psot0 := true))))
  -- TNsot
  f := f + (← expectKind "TNsot = 2, one part" "malformed" (parse (h4 ++ tp 0 0 2 [] [] ++ eoc)))
  f := f + (← expectKind "TNsot 2 vs 3" "malformed"
    (parse (h4 ++ tp 0 0 2 [] [] ++ tp 0 1 3 [] [] ++ eoc)))
  f := f + (← expectKind "TNsot = 0 everywhere" "ok"
    (parse (h4 ++ tp 0 0 0 [] [] ++ tp 0 1 0 [] [] ++ eoc)))
  f := f + (← expectKind "TPsot ≥ TNsot" "malformed" (parse (h4 ++ tp 0 1 1 [] [] ++ eoc)))
  -- Isot, TPsot
  f := f + (← expectKind "Isot out of range" "malformed" (parse (h4 ++ tp 4 0 1 [] [] ++ eoc)))
  f := f + (← expectKind "Isot = 3 in range" "ok" (parse (h4 ++ tp 3 0 1 [] [] ++ eoc)))
  f := f + (← expectKind "duplicate TPsot" "malformed"
    (parse (h4 ++ tp 0 0 0 [] [] ++ tp 0 0 0 [] [] ++ eoc)))
  f := f + (← expectKind "TPsot out of order" "malformed"
    (parse (h4 ++ tp 0 1 0 [] [] ++ tp 0 0 0 [] [] ++ eoc)))
  -- truncation and terminators
  f := f + (← expectKind "missing EOC" "truncated" (parse (h4 ++ tp 0 0 1 [] [1])))
  f := f + (← expectKind "Psot past end" "truncated"
    (parse (h4 ++ (tp 0 0 1 [] [1, 2, 3]).take (h4.length + 15))))
  f := f + (← expectKind "truncated SOT" "truncated"
    (parse (h4 ++ (tp 0 0 1 [] []).take 7)))
  f := f + (← expectKind "bytes after EOC ignored" "ok"
    (parse (h4 ++ tp 0 0 1 [] [] ++ eoc ++ [1, 2, 3])))
  f := f + (← expectKind "garbage instead of SOT" "malformed" (parse (h4 ++ [0, 0] ++ eoc)))
  f := f + (← expectKind "Lsot = 11" "malformed"
    (parse (h4 ++ be16 0xFF90 ++ be16 11 ++ be16 0 ++ be32 15 ++ [0, 1, 0] ++ be16 0xFF93 ++
      eoc)))
  f := f + (← expectKind "Psot = 12" "malformed"
    (parse (h4 ++ be16 0xFF90 ++ be16 10 ++ be16 0 ++ be32 12 ++ [0, 1] ++ eoc)))
  f := f + (← expectKind "non-marker in tile-part header" "malformed"
    (parse (h4 ++ be16 0xFF90 ++ be16 10 ++ be16 0 ++ be32 14 ++ [0, 1] ++ [0, 0] ++ eoc)))
  -- tile-part header segments
  let cod := seg 0xFF52 codBody
  let com := seg 0xFF64 (be16 1 ++ [65])
  f := f + (← expect "COD, COM in first tile-part"
    ((ok? (parse (h4 ++ tp 0 0 1 (cod ++ com) [1] ++ eoc))).map (fun ts =>
      ts.toList.map fun t => t.parts.toList.map fun p => (p.segments.size, p.markers.size))
      == some [[(2, 4)]]))
  f := f + (← expectKind "COD in second tile-part" "malformed"
    (parse (h4 ++ tp 0 0 2 [] [] ++ tp 0 1 2 cod [] ++ eoc)))
  f := f + (← expectKind "COM in second tile-part" "ok"
    (parse (h4 ++ tp 0 0 2 [] [] ++ tp 0 1 2 com [] ++ eoc)))
  f := f + (← expectKind "two COD in a header" "malformed"
    (parse (h4 ++ tp 0 0 1 (cod ++ cod) [] ++ eoc)))
  f := f + (← expectKind "TLM in a tile-part header" "malformed"
    (parse (h4 ++ tp 0 0 1 (seg 0xFF55 [0, 0]) [] ++ eoc)))
  -- limits
  f := f + (← expectKind "maxTiles" "limit"
    (parseWith { maxTiles := 3 } (h4 ++ tp 0 0 1 [] [] ++ eoc)))
  f := f + (← expectKind "maxTilePartsPerTile" "limit"
    (parseWith { maxTilePartsPerTile := 1 } (h4 ++ tp 0 0 0 [] [] ++ tp 0 1 0 [] [] ++ eoc)))
  f := f + (← expectKind "TNsot > maxTilePartsPerTile" "limit"
    (parseWith { maxTilePartsPerTile := 2 } (h4 ++ tp 0 0 3 [] [] ++ eoc)))
  f := f + (← expectKind "maxTileParts" "limit"
    (parseWith { maxTileParts := 1 } (h4 ++ tp 0 0 1 [] [] ++ tp 1 0 1 [] [] ++ eoc)))
  return f

/-- `n` tile-parts `0…n−1` of tile `i`, all declaring `TNsot = tn`, one data byte each. -/
def parts (i tn n : Nat) : List UInt8 :=
  (List.range n).foldl (fun acc k => acc ++ tp i k tn [] [k.toUInt8]) []

/-- `(index, tnsot, number of parts)` of each tile of a successful parse. -/
def tnsots (x : Except Error (Array Tile)) : Option (List (Nat × Nat × Nat)) :=
  (ok? x).map fun ts => ts.toList.map fun t => (t.index, t.tnsot, t.parts.size)

/-- `TNsot` one too small: OpenJPEG's correction (module doc of `JPEG2000.TilePart`). -/
def tnsotTests : IO Nat := do
  let mut f := 0
  let h4 := mainHdr 32 16
  f := f + (← expect "TNsot = 2 with 3 parts: corrected"
    (tnsots (parse (h4 ++ parts 0 2 3 ++ eoc)) == some [(0, 3, 3)]))
  f := f + (← expect "TNsot = 5 with 6 parts (issue208 shape): corrected"
    (tnsots (parse (h4 ++ parts 0 5 6 ++ parts 1 5 6 ++ eoc)) == some [(0, 6, 6), (1, 6, 6)]))
  f := f + (← expectKind "parseSOT TPsot = TNsot" "ok"
    (parseSOT (rd (be16 0 ++ be32 14 ++ [2, 2]))))
  f := f + (← expectKind "parseSOT TPsot > TNsot" "malformed"
    (parseSOT (rd (be16 0 ++ be32 14 ++ [3, 2]))))
  f := f + (← expectKind "TNsot two too small" "malformed"
    (parse (h4 ++ parts 0 2 4 ++ eoc)))
  f := f + (← expectKind "TNsot = 1 with 2 parts (no correction for TNsot = 1)" "malformed"
    (parse (h4 ++ parts 0 1 2 ++ eoc)))
  f := f + (← expectKind "extra part declaring TNsot = 0: no correction" "malformed"
    (parse (h4 ++ parts 0 2 2 ++ tp 0 2 0 [] [] ++ eoc)))
  -- The decision is taken at the first completed tile and applies to every tile.
  f := f + (← expect "correction detected on a later-completing tile applies to all"
    (tnsots (parse (h4 ++ tp 0 0 2 [] [] ++ parts 1 2 3 ++ tp 0 1 2 [] [] ++ tp 0 2 2 [] [] ++
      eoc)) == some [(0, 3, 3), (1, 3, 3)]))
  f := f + (← expectKind "correction on: a tile with exactly TNsot parts is short" "malformed"
    (parse (h4 ++ parts 0 2 3 ++ parts 1 2 2 ++ eoc)))
  f := f + (← expectKind "first completed tile exact: later TPsot = TNsot rejected" "malformed"
    (parse (h4 ++ parts 0 2 2 ++ parts 1 2 3 ++ eoc)))
  f := f + (← expect "correction on: TNsot = 0 tiles unaffected"
    (tnsots (parse (h4 ++ parts 0 2 3 ++ parts 1 0 2 ++ eoc)) == some [(0, 3, 3), (1, 0, 2)]))
  return f

/-- PLT, PPT, TLM and PPM tests. -/
def pointerTests : IO Nat := do
  let mut f := 0
  let h4 := mainHdr 32 16
  -- PLT varints: 5, 200 = 0x81 0x48, 16384 = 0x81 0x80 0x00, 127
  let plt0 := seg 0xFF58 [0, 5, 0x81, 0x48]
  let plt1 := seg 0xFF58 [1, 0x81, 0x80, 0x00, 0x7F]
  f := f + (← expect "PLT body"
    ((ok? (parsePLT (rd [3, 5, 0x81, 0x48, 0x81, 0x80, 0x00]))).map (·.lengths.toList) ==
      some [5, 200, 16384]))
  f := f + (← expectKind "PLT pending length" "malformed" (parsePLT (rd [0, 5, 0x81])))
  f := f + (← expectKind "PLT ≥ 2^32" "malformed"
    (parsePLT (rd [0, 0x90, 0x80, 0x80, 0x80, 0x00])))
  f := f + (← expectKind "PLT empty body" "truncated" (parsePLT (rd [])))
  f := f + (← expect "PLT merged in Zplt order across parts"
    ((ok? (parse (h4 ++ tp 0 0 2 (plt1 ++ plt0) [] ++ tp 0 1 2 (seg 0xFF58 [0, 9]) [] ++
      eoc))).map (fun ts => ts.toList.map (·.plt.toList)) ==
      some [[5, 200, 16384, 127, 9]]))
  f := f + (← expectKind "duplicate Zplt" "malformed"
    (parse (h4 ++ tp 0 0 1 (plt0 ++ plt0) [] ++ eoc)))
  -- PPT
  let ppt1 := seg 0xFF61 [1, 0xAA, 0xBB]
  let ppt0 := seg 0xFF61 [0, 0xCC]
  let s := h4 ++ tp 0 0 2 ppt1 [] ++ tp 0 1 2 ppt0 [] ++ eoc
  let o1 := h4.length + 12 + 5
  let o0 := h4.length + 12 + ppt1.length + 2 + 12 + 5
  f := f + (← expect "PPT merged in Zppt order"
    ((ok? (parse s)).map (fun ts => ts.toList.map (·.ppt.toList)) ==
      some [[{ offset := o0, length := 1 }, { offset := o1, length := 2 }]]))
  f := f + (← expectKind "duplicate Zppt in a tile" "malformed"
    (parse (h4 ++ tp 0 0 2 ppt0 [] ++ tp 0 1 2 ppt0 [] ++ eoc)))
  f := f + (← expectKind "same Zppt in two tiles" "ok"
    (parse (h4 ++ tp 0 0 1 ppt0 [] ++ tp 1 0 1 ppt0 [] ++ eoc)))
  f := f + (← expectKind "PPT without data" "malformed" (parsePPT (rd [0])))
  f := f + (← expectKind "PPT with main-header PPM" "malformed"
    (parse (mainHdr 32 16 (seg 0xFF60 ([0] ++ be32 0)) ++ tp 0 0 1 ppt0 [] ++ eoc)))
  -- TLM
  f := f + (← expect "TLM ST=1 SP=0"
    ((ok? (parseTLM Limits.default (rd ([0, 0x10, 3] ++ be16 100 ++ [1] ++ be16 50)))) ==
      some { ztlm := 0, st := 1, sp := false,
             entries := #[{ tile := some 3, length := 100 }, { tile := some 1, length := 50 }] }))
  f := f + (← expect "TLM ST=0 SP=1"
    ((ok? (parseTLM Limits.default (rd ([2, 0x40] ++ be32 70000)))) ==
      some { ztlm := 2, st := 0, sp := true, entries := #[{ tile := none, length := 70000 }] }))
  f := f + (← expect "TLM ST=2 SP=1"
    ((ok? (parseTLM Limits.default (rd ([0, 0x60] ++ be16 513 ++ be32 20)))).map (·.entries) ==
      some #[{ tile := some 513, length := 20 }]))
  f := f + (← expectKind "TLM ST=3" "malformed" (parseTLM Limits.default (rd [0, 0x30])))
  f := f + (← expectKind "TLM reserved bit" "malformed" (parseTLM Limits.default (rd [0, 0x01])))
  f := f + (← expectKind "TLM partial entry" "malformed"
    (parseTLM Limits.default (rd [0, 0x10, 1, 0])))
  f := f + (← expectKind "TLM entries > maxTileParts" "limit"
    (parseTLM { maxTileParts := 1 } (rd ([0, 0x00] ++ be16 14 ++ be16 14))))
  -- PPM spanning segments (given out of Zppm order) and parsePointers
  -- data: Nppm=3, [1,2,3], Nppm=1, [4]; split as Z0 = [0,0,0,3,1], Z1 = [2,3,0,0,0,1,4]
  let ppmZ1 := seg 0xFF60 [1, 2, 3, 0, 0, 0, 1, 4]
  let ppmZ0 := seg 0xFF60 [0, 0, 0, 0, 3, 1]
  let tlm := seg 0xFF55 ([0, 0x10, 0] ++ be16 14)
  let hp := mainHdr 32 16 (ppmZ1 ++ tlm ++ ppmZ0)
  let z1 := (mainHdr 32 16).length + 4 + 1
  let z0 := z1 + ppmZ1.length + tlm.length
  let bs := (hp ++ tp 0 0 1 [] [] ++ eoc)
  let pp := do
    let (mh, _) ← parseMainHeader Limits.default (rd bs)
    parsePointers Limits.default mh bs.toByteArray
  f := f + (← expect "PPM chunks across segments"
    ((ok? pp).map (fun (t, p) => (t.size, p.segments.toList.map (·.zppm),
      p.chunks.toList.map (·.toList))) ==
      some (1, [0, 1],
        [[{ offset := z0 + 4, length := 1 }, { offset := z1, length := 2 }],
         [{ offset := z1 + 6, length := 1 }]])))
  let bad := mainHdr 32 16 (seg 0xFF60 [0, 0, 0, 0, 5, 1]) ++ tp 0 0 1 [] [] ++ eoc
  let pbad := do
    let (mh, _) ← parseMainHeader Limits.default (rd bad)
    parsePointers Limits.default mh bad.toByteArray
  f := f + (← expectKind "PPM Ippm past data" "malformed" pbad)
  let dup := mainHdr 32 16 (ppmZ0 ++ ppmZ0) ++ tp 0 0 1 [] [] ++ eoc
  let pdup := do
    let (mh, _) ← parseMainHeader Limits.default (rd dup)
    parsePointers Limits.default mh dup.toByteArray
  f := f + (← expectKind "duplicate Zppm" "malformed" pdup)
  return f

/-! ## Corpus table -/

/-- Expected values per T.803 stream (from the throwaway walker, see the module doc). -/
structure Row where
  /-- File name without `.j2k`. -/
  file : String
  /-- Number of tile-parts. -/
  parts : Nat
  /-- Number of tiles with tile-parts. -/
  tiles : Nat
  /-- Tiles with more than one tile-part: (index, count). -/
  multi : List (Nat × Nat)
  /-- Sum of the `SOT` marker offsets. -/
  sumPos : Nat
  /-- Sum of the bit-stream data start offsets (after `SOD`). -/
  sumStart : Nat
  /-- Sum of the tile-part end offsets. -/
  sumEnd : Nat
  /-- Number of tile-part header marker segments (all tile-parts). -/
  segs : Nat
  /-- Number of PLT packet lengths. -/
  nplt : Nat
  /-- Sum of the PLT packet lengths. -/
  sumPlt : Nat
  /-- Total `Ippt` bytes. -/
  pptBytes : Nat
  /-- Number of TLM entries. -/
  tlm : Nat
  /-- Number of PPM chunks. -/
  ppm : Nat

