/-- Sum of a list of numbers. -/
def sumN (xs : List Nat) : Nat := xs.foldl (· + ·) 0

/-- Compares a parse with a row; returns the names of mismatching fields. -/
def compare (row : Row) (ts : Array Tile) (tlms : Array TLM) (ppm : PPMData) : List String :=
  let parts := ts.toList.flatMap (·.parts.toList)
  let chk (n : String) (b : Bool) : List String := if b then [] else [n]
  chk "parts" (parts.length == row.parts) ++
  chk "tiles" (ts.size == row.tiles) ++
  chk "multi" ((ts.toList.filter (·.parts.size > 1)).map (fun t => (t.index, t.parts.size))
    == row.multi) ++
  chk "sumPos" (sumN (parts.map (·.pos)) == row.sumPos) ++
  chk "sumStart" (sumN (parts.map (·.data.offset)) == row.sumStart) ++
  chk "sumEnd" (sumN (parts.map (·.data.stop)) == row.sumEnd) ++
  chk "segs" (sumN (parts.map (·.segments.size)) == row.segs) ++
  chk "nplt" (sumN (ts.toList.map (·.plt.size)) == row.nplt) ++
  chk "sumPlt" (sumN (ts.toList.map (fun t => sumN t.plt.toList)) == row.sumPlt) ++
  chk "pptBytes" (sumN (ts.toList.map (fun t => sumN (t.ppt.toList.map (·.length)))) ==
    row.pptBytes) ++
  chk "tlm" (sumN (tlms.toList.map (·.entries.size)) == row.tlm) ++
  chk "ppm" (ppm.chunks.size == row.ppm) ++
  -- PLT lengths cover the tile's data exactly (no PPT/PPM in the streams that have PLT)
  chk "plt=data" (ts.all fun t => t.plt.isEmpty ||
    sumN t.plt.toList == sumN (t.parts.toList.map (·.data.length)))

/-- Directory of the T.803 streams (relative to the repository root). -/
def corpusDir : System.FilePath := "corpus/files/openjpeg-data/input/conformance"

/-- Parses every T.803 stream fully and compares with `table`; skips absent files. -/
def corpus : IO Nat := do
  let mut f := 0
  let mut checked := 0
  for row in table do
    let p := corpusDir / (row.file ++ ".j2k")
    if !(← p.pathExists) then continue
    checked := checked + 1
    let data ← IO.FS.readBinFile p
    let res := do
      let (mh, r) ← parseMainHeader Limits.default (Reader.ofByteArray data)
      let (tlms, ppm) ← parsePointers Limits.default mh data
      let ts ← parseTileParts Limits.default mh r
      return (ts, tlms, ppm)
    match res with
    | .error e => f := f + (← expect s!"{row.file}: {e}" false)
    | .ok (ts, tlms, ppm) =>
      let bad := compare row ts tlms ppm
      f := f + (← expect s!"{row.file}: mismatch in {bad}" bad.isEmpty)
  if checked == 0 then IO.println "  tilepart: corpus absent, skipped"
  else if checked < table.length then
    IO.println s!"  tilepart: {checked}/{table.length} corpus streams present"
  return f

/-- Runs every tile-part test; returns the number of failures. -/
def run : IO Nat := do
  return (← structureTests) + (← tnsotTests) + (← pointerTests) + (← corpus)

end JPEG2000.Tests.TilePart
